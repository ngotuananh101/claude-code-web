{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The browser needs the DOM the base config's Bun-only settings leave out,
    // and `bun` types would lie here — nothing in this app runs in Bun.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@cc-web/protocol": ["../../packages/protocol/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
