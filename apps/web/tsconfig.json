{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The browser needs the DOM the base config's Bun-only settings leave
    // out. `bun` types are here for the specs (bun:test) — the app code
    // itself never touches Bun globals.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "bun"],
    "paths": {
      "@cc-web/protocol": ["../../packages/protocol/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
