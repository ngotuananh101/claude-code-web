# Control Server
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8787
CONTROL_DB_PATH=./data/control.sqlite
# Public origin used for cookie/CSRF and browser WebSocket origin checks
PUBLIC_ORIGIN=http://localhost:5173

# Runner
RUNNER_DATA_DIR=./data/runner
RUNNER_ALLOWED_ROOTS=
# Enrollment token is passed interactively to `runner enroll`; never store it here.
