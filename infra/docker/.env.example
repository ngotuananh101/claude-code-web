# Environment for the production compose stack (infra/docker/compose.prod.yml).
#
# Copy this file to `.env` next to the compose file and fill it in. The `.env`
# file is gitignored and must never be committed.
#
#   cp infra/docker/.env.example infra/docker/.env
#
# Compose reads `.env` for the ${...} interpolation in the compose file and
# passes the same file to the control container via env_file.

# Required. HS256 signing key for `cc_session` access tokens; the server
# refuses to start with fewer than 32 bytes. Generate one with:
#   openssl rand -base64 48
CC_WEB_JWT_SECRET=

# Required. The exact browser origin(s) allowed to log in, open `/ws/browser`
# and mint runner credentials — comma-separated, scheme included, no trailing
# slash. This is the origin the external TLS proxy publishes, not the loopback
# address of this compose stack. Behind an https proxy it is:
CC_WEB_ALLOWED_ORIGINS=https://cc.example.com

# What Caddy listens on inside the web container. Keep `:80` when an external
# proxy terminates TLS. Set a bare domain (cc.example.com) to let Caddy obtain
# certificates itself; then publish 80/443 instead of the loopback mapping.
CC_WEB_SITE_ADDRESS=:80

# Host side of the web container's port 80. The default binds loopback so the
# proxy already running on this host fronts it; use 0.0.0.0 for direct LAN
# access (and make sure the proxy does not conflict on the port).
CC_WEB_BIND_ADDR=127.0.0.1
CC_WEB_HTTP_PORT=8080
