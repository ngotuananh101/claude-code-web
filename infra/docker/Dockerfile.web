# Production image for the Vue client (§20.1).
#
# Two stages: the SPA is built with the repo's own toolchain (Vite 8, plus the
# TypeScript 5 shim @vue/compiler-sfc needs), then served by Caddy. Caddy is
# also the reverse proxy in front of the control server, so the browser sees a
# single origin — which is what keeps the same-origin `cc_session` cookie and
# the Origin allowlist working unchanged from development.
#
# Deployed by infra/docker/compose.prod.yml; operating notes in
# docs/DEPLOYMENT.md.

FROM oven/bun:1.4.3-debian AS build

WORKDIR /app

# Same dependency-layer shape as Dockerfile.control: package manifests first,
# source second.
COPY package.json bun.lock ./
COPY apps/control-server/package.json apps/control-server/
COPY apps/runner/package.json apps/runner/
COPY apps/web/package.json apps/web/
COPY packages/agent-adapter/package.json packages/agent-adapter/
COPY packages/control-db/package.json packages/control-db/
COPY packages/protocol/package.json packages/protocol/
COPY packages/runner-db/package.json packages/runner-db/
COPY packages/shared/package.json packages/shared/

# The build needs devDependencies (Vite, @vitejs/plugin-vue, the `typescript5`
# alias), so this install is a full one. The Claude asset postinstall is
# skipped: nothing the web client imports needs it.
RUN bun install --ignore-scripts

COPY . .

RUN cd apps/web && bun run build

# Caddy serves the built assets and proxies the control surfaces; see
# infra/docker/Caddyfile.
FROM caddy:2.10-alpine

COPY --from=build /app/apps/web/dist /srv
COPY infra/docker/Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443
