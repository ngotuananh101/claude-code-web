# Front door of the single production container (§20.1).
#
# Default is plain HTTP on port 80 inside the container: the operator's existing
# TLS proxy publishes it (compose.prod.yml binds it to loopback). Set
# CC_WEB_SITE_ADDRESS to a bare domain to let Caddy own TLS instead — then
# publish 80/443 and drop the loopback binding.
#
# The control server runs beside Caddy in the same container, on loopback. One
# origin is what keeps the cc_session cookie and the Origin allowlist
# unchanged: the browser talks to Caddy for everything.

# The generated theme (apps/web/src/styles/index.css) starts with a Google
# Fonts `@import`, so the CSP must allow that stylesheet and the font files it
# points at — otherwise the browser blocks both and the SPA falls back to a
# system font. The same font is also bundled locally via
# @fontsource-variable/figtree, so an offline build still renders correctly.
# The snippet is defined once so the two SPA routes cannot drift apart.
(csp) {
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' wss: https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
}

{$CC_WEB_SITE_ADDRESS::80} {
	encode zstd gzip

	# The control server's HTTP and WebSocket surfaces. Caddy's reverse_proxy
	# upgrades WebSocket connections transparently, so /ws/runner and
	# /ws/browser need no special configuration.
	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}
	handle /auth/* {
		reverse_proxy 127.0.0.1:8787
	}
	handle /ws/* {
		reverse_proxy 127.0.0.1:8787
	}
	handle /healthz {
		reverse_proxy 127.0.0.1:8787
	}

	# The SPA. Missing assets stay 404s instead of answering HTML to a script
	# request; every other path falls back to index.html so the client router
	# owns deep links.
	@assets path /assets/*
	handle @assets {
		# CSP only on the SPA responses: API and attachment responses keep
		# their own headers (attachments carry a sandbox CSP from the
		# control server, which a site-level CSP would overwrite).
		import csp
		root * /srv
		file_server
	}
	handle {
		import csp
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		# Ignored by browsers over plain http, takes effect only once
		# the site is served over https (external proxy or Caddy TLS).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
